# 🌐 MOODLE COOLIFY STACK - Configuration d'environnement
# ======================================================
# IMPORTANT : Configurez ces variables directement dans Coolify
# sous "Environment Variables" lors du déploiement

# --- Domaine principal ---
# ⚠️ OBLIGATOIRE : Configurez votre domaine dans Coolify
DOMAIN=ecole-en-ligne.ceredis.net

# --- Base de données MariaDB ---
# ⚠️ OBLIGATOIRE : Mots de passe sécurisés
MYSQL_ROOT_PASSWORD=SuperRootPass!
MOODLE_DB_PASSWORD=SuperDbPass!

# --- Compte administrateur Moodle ---
# ⚠️ OBLIGATOIRE : Compte admin créé lors de la première installation
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=SuperAdminPass!
MOODLE_ADMIN_EMAIL=admin@ceredis.net

# --- Paramètres Moodle ---
MOODLE_SITE_NAME=École en Ligne CEREDIS
MOODLE_SITE_SHORTNAME=CEREDIS

# --- Connexions externes (OPTIONNEL) ---
# LRS / Learning Locker (xAPI)
LRS_ENDPOINT=https://learning-locker.ceredis.net/data/xAPI/
LRS_USERNAME=votre_username_lrs
LRS_PASSWORD=votre_password_lrs

# LTI / SeSaLab
LTI_CLIENT_ID=sesalab_client
LTI_CLIENT_SECRET=sesalab_secret_key
LTI_PLATFORM_URL=https://sesalab.ceredis.net

# --- Sauvegardes Dropbox (OPTIONNEL) ---
# Token généré avec "rclone config" ou depuis votre application Dropbox
DROPBOX_TOKEN={"access_token":"VOTRE_TOKEN_ICI","token_type":"bearer","expiry":"0001-01-01T00:00:00Z"}

# --- Paramètres système ---
TIMEZONE=Africa/Brazzaville
PHP_MEMORY_LIMIT=512M
UPLOAD_MAX_SIZE=256M
MAX_EXECUTION_TIME=300

# --- Vérification des plugins au démarrage (OPTIONNEL) ---
# Liste séparée par des virgules de "famille:nom" pour contrôler la présence et l'emplacement
# Familles supportées: theme, mod, block, auth, local, filter, qtype, tiny, enrol, tool, report, repository, plagiarism, availability, dataformat
# Exemple complet (adapté à ce dépôt):
# PLUGIN_CHECK_COMPONENTS="theme:adaptable,local:wirisquizzes,filter:wiris,qtype:wq,qtype:essaywiris,qtype:matchwiris,qtype:multianswerwiris,qtype:multichoicewiris,qtype:shortanswerwiris,qtype:truefalsewiris,tiny:wiris,mod:zoom,local:obf,mod:learningmap,format:learningmap,block:completion_progress"
# Note: pour les formats de cours, utilisez tool=course/format via la famille 'format' ci-dessous.
PLUGIN_CHECK_COMPONENTS=